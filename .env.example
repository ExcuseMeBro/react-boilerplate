# Same-origin API works across deployments; optional absolute URL for development:
# VITE_API_URL=http://localhost:8080/api
# Absolute API URLs MUST use HTTPS in production. VITE_* values are public.
VITE_API_URL=/api

# cookie: server-set HttpOnly Secure SameSite cookie (recommended)
# bearer: in-memory access token + HttpOnly refresh cookie; never localStorage
VITE_AUTH_STRATEGY=cookie

# Positive integer in milliseconds
VITE_REQUEST_TIMEOUT_MS=15000

# Dev/preview bind to loopback by default. Opt in to LAN access only if needed.
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_PORT=3000
# VITE_PREVIEW_PORT=4173
